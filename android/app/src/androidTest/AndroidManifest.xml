<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="com.chronolock.blocking.VerificationTargetActivity" android:exported="true" android:label="ChronoLock test target">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.chronolock.blocking.VerificationDetailActivity" android:exported="true" />
        <activity android:name="com.chronolock.blocking.VerificationPipActivity" android:exported="true"
            android:supportsPictureInPicture="true" android:resizeableActivity="true"
            android:taskAffinity="com.chronolock.verification.pip" android:launchMode="singleTask"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation" />
    </application>
</manifest>
