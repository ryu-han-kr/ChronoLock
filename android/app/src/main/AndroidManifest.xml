<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only for the once-a-day "daily limit nearly used" reminder. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Network is used only for optional sign-in and banner ads; usage data stays on the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
        <intent><action android:name="android.intent.action.DIAL" /><data android:scheme="tel" /></intent>
        <intent><action android:name="android.telecom.InCallService" /></intent>
    </queries>
    <application android:name=".ChronoLockApplication" android:allowBackup="false"
        android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name" android:icon="@drawable/ic_chronolock"
        android:theme="@style/Theme.ChronoLock" android:supportsRtl="true">
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="${admobAppId}" />
        <!-- WorkManager reads ChronoLockApplication's configuration on demand instead of the default initializer. -->
        <provider android:name="androidx.startup.InitializationProvider" android:authorities="${applicationId}.androidx-startup"
            android:exported="false" tools:node="merge">
            <meta-data android:name="androidx.work.WorkManagerInitializer" android:value="androidx.startup" tools:node="remove" />
        </provider>
        <service android:name=".data.HistoryJobService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".blocking.ChronoAccessibilityService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true" android:label="@string/service_label">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service" />
        </service>
        <service android:name=".blocking.FocusTileService" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true" android:label="@string/tile_focus_label" android:icon="@drawable/ic_tile_focus">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <receiver android:name=".blocking.TodayWidget" android:exported="false" android:label="@string/app_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_info" />
        </receiver>
    </application>
</manifest>
